    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "dompurify": "^3.2.6",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^10.9.5",
